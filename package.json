{
  "name": "ai-portable-interpreter",
  "version": "0.2.0",
  "license": "MIT",
  "private": false,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "proxy": "tsx server/start-realtime-proxy.ts",
    "dev:all": "concurrently -k -n NEXT,PROXY -c cyan,green \"npm run dev\" \"npm run proxy\"",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "start:cloud": "tsx server/cloud-server.ts",
    "build:fc-server": "tsc -p tsconfig.fc.json",
    "start:fc": "NODE_ENV=production HOSTNAME=0.0.0.0 PORT=${FC_SERVER_PORT:-9000} REALTIME_PROXY_PATH=${REALTIME_PROXY_PATH:-/realtime} node server/cloud-server.js",
    "package:fc": "powershell -ExecutionPolicy Bypass -File scripts/package-fc.ps1",
    "app:android:sync": "powershell -ExecutionPolicy Bypass -File scripts/build-android-app.ps1",
    "app:android:toolchain": "powershell -ExecutionPolicy Bypass -File scripts/setup-android-toolchain.ps1",
    "app:android:apk": "powershell -ExecutionPolicy Bypass -File scripts/build-android-apk.ps1",
    "app:android:open": "npx cap open android",
    "build": "next build",
    "postbuild": "node scripts/prepare-capacitor-webdir.mjs",
    "lint": "eslint . --max-warnings=0",
    "doctor": "tsx scripts/doctor.ts",
    "setup:check": "npm run doctor",
    "test": "tsx scripts/test-language-registry.ts && tsx scripts/test-openai-provider.ts && tsx scripts/test-provider-contract.ts && tsx scripts/test-gateway-security.ts",
    "test:gateway": "tsx scripts/test-gateway.ts",
    "test:provider-contract": "tsx scripts/test-provider-contract.ts",
    "test:gateway-security": "tsx scripts/test-gateway-security.ts",
    "test:fc-env": "node scripts/test-fc-env.mjs",
    "test:connection": "tsx scripts/test-realtime-connection.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "dotenv": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "ws": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/ws": "latest",
    "concurrently": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
