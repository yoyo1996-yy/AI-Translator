DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
REALTIME_PROXY_URL=
DEBUG_REALTIME=false
ENABLE_TRANSLATION_GLOSSARY=false

# Local development defaults to ws://127.0.0.1:3001 when this is empty.
# Production can leave this empty and the browser will use the current HTTPS
# host as wss://<current-host>/realtime. You may also set it explicitly after
# Function Compute provides the public URL.
# NEXT_PUBLIC_REALTIME_PROXY_URL=wss://your-fc-public-host/realtime
NEXT_PUBLIC_REALTIME_PROXY_URL=

# Production server options.
REALTIME_PROXY_PATH=/realtime
ALLOWED_ORIGINS=

# Optional Gateway security.
# Personal deployment can leave APP_ACCESS_TOKEN empty to keep existing clients working.
# Private native/backend clients can set a private token and send it as:
# Authorization: Bearer <APP_ACCESS_TOKEN>
# Browser/WebView clients can send {"type":"auth","token":"..."} as the first WebSocket message,
# but do not put this token in a public frontend bundle.
APP_ACCESS_TOKEN=
MAX_SESSION_DURATION_SECONDS=
MAX_AUDIO_BYTES_PER_SESSION=
MAX_MESSAGE_SIZE_BYTES=
MAX_CONCURRENT_SESSIONS_PER_CLIENT=
RATE_LIMIT_WINDOW_SECONDS=
MAX_CONNECTION_ATTEMPTS_PER_WINDOW=
