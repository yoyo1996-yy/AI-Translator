# Docker smoke-test default. This does not call a paid AI provider.
TRANSLATION_PROVIDER=mock

# Server
PORT=9000
HOSTNAME=0.0.0.0
REALTIME_PROXY_PATH=/realtime
DEBUG_REALTIME=false
ENABLE_TRANSLATION_GLOSSARY=false

# Set this only if your web client is built for a different Gateway host.
NEXT_PUBLIC_REALTIME_PROXY_URL=

# Bailian provider mode requires server-side credentials.
# Do not put real values in the repository.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing

# Optional Gateway access control.
APP_ACCESS_TOKEN=

# Optional Gateway limits.
MAX_SESSION_DURATION_SECONDS=
MAX_AUDIO_BYTES_PER_SESSION=
MAX_MESSAGE_SIZE_BYTES=
MAX_CONCURRENT_SESSIONS_PER_CLIENT=
RATE_LIMIT_WINDOW_SECONDS=
MAX_CONNECTION_ATTEMPTS_PER_WINDOW=
